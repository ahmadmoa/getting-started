# Copy this file to ".env" (same folder) and change what you need.
#
# How headlines get judged:
#   claude-code  uses the Claude Code program on this PC, signed in with your
#                own Claude plan (Pro/Max). No API key, no extra bill; it uses
#                your plan's usage limits. This is the default when no API key
#                is set below.
#   api          uses an API key from https://console.anthropic.com (pay per use).
# JUDGE_WITH=claude-code

# Only for JUDGE_WITH=api:
# ANTHROPIC_API_KEY=

# Model and effort. A smaller model uses less of your plan's limits / costs less.
# CLASSIFY_MODEL=claude-haiku-5-5
# CLASSIFY_EFFORT=low

# How often to fetch news and judge it, in seconds (default 300 with
# claude-code, 60 with api).
# POLL_SECONDS=300

# Tell Claude how markets are reacting right now.
# MARKET_CONTEXT=Markets trade Middle East escalation as inflationary: oil up, yields up, dollar up, gold down.

# Only if Claude Code is installed somewhere unusual:
# CLAUDE_CODE_PATH=C:\Users\you\.local\bin\claude.exe

# Different port if 3000 is taken.
# PORT=3000
